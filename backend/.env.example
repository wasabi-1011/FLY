# FLY 品牌官网 · 后端环境变量示例
# 复制为 .env 后按需修改

# 应用
PROJECT_NAME=FLY Brand Official Website API
API_V1_PREFIX=/api

# 数据库：统一 SQLite(async)，单文件零运维（PRD v1.5 定稿）
# 如未来扩展，可切 PostgreSQL(asyncpg) 示例：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fly
DATABASE_URL=sqlite+aiosqlite:///./fly.db
DB_ECHO=false

# Redis（可选；未配置时缓存/限频降级为内存实现）
# REDIS_URL=redis://localhost:6379/0

# 安全
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_MAX_FAIL=5
LOCK_MINUTES=15

# 留言限频（次/小时/IP）
CONTACT_LIMIT_PER_HOUR=10

# CORS（前台域名）
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 地图（腾讯位置服务）
# 服务端 Key：仅供后台「地址 → 坐标」地理编码（POST /api/admin/stores/geocode）使用，
# 只存在服务端、不返回前端、不落库；正式环境严禁提交进版本库。
# 留空时该接口返回 501，后台门店弹窗自动降级为「地图点选 / 手工录入坐标」，不影响门店 CRUD。
# 申请入口：https://lbs.qq.com/ （控制台 → 应用管理 → 添加 Key，勾选 WebServiceAPI）
TMAP_SERVER_KEY=
# 地理编码请求超时（秒）
TMAP_TIMEOUT=5.0

# 前端底图 Key（腾讯地图 GL JS）不在这里配置：
# 由 frontend/web/index.html 与 backendManage/index.html 的 window.__FLY_TMAP_KEY__ 注入，
# 且必须在控制台配置 Referer 白名单（localhost:3000 / localhost:8000 / 生产域名）。
