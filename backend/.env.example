# FLY 品牌官网 · 后端环境变量示例
# 复制为 .env 后按需修改

# 应用
PROJECT_NAME=FLY Brand Official Website API
API_V1_PREFIX=/api

# 数据库：统一 SQLite(async)，单文件零运维（PRD v1.5 定稿）
# 如未来扩展，可切 PostgreSQL(asyncpg) 示例：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fly
DATABASE_URL=sqlite+aiosqlite:///./fly.db
DB_ECHO=false

# Redis（可选；未配置时缓存/限频降级为内存实现）
# REDIS_URL=redis://localhost:6379/0

# 安全
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_MAX_FAIL=5
LOCK_MINUTES=15

# 留言限频（次/小时/IP）
CONTACT_LIMIT_PER_HOUR=10

# CORS（前台域名）
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
